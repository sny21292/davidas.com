# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.

# Resend API key (https://resend.com) — used by the 3 form handlers.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "From" address — must be a verified Resend domain/sender.
MAIL_FROM="Davidas Design Concepts <noreply@davidas.com>"

# Where contact + jewelry-inquiry emails are delivered.
NOTIFY_EMAIL=davidas.design@yahoo.com

# Gospel Necklace orders go to a SEPARATE inbox (do not consolidate).
ORDER_NOTIFY_EMAIL=gospel.necklace@yahoo.com

# Public site origin — used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://www.davidas.com

# Staging guard. Set to 1 ONLY on the Vercel sandbox (davidas-com.vercel.app) to
# keep it out of Google: robots.txt disallow-all + noindex meta + X-Robots-Tag.
# Leave unset on the live VPS, or the production site will be deindexed.
# NEXT_PUBLIC_NOINDEX=1

# Supabase (server/build-time only — powers the Showcase). REQUIRED to build:
# /showcase, /showcase/[slug] and sitemap.ts fetch from Supabase at build time,
# and src/lib/supabase.ts throws if these are missing. Anon key is read-only (RLS).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
