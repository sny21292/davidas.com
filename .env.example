# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.

# Resend API key (https://resend.com) — used by the 3 form handlers.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "From" address — must be a verified Resend domain/sender.
MAIL_FROM="Davidas Design Concepts <noreply@davidas.com>"

# Where contact + jewelry-inquiry emails are delivered.
NOTIFY_EMAIL=davidas.design@yahoo.com

# Gospel Necklace orders go to a SEPARATE inbox (do not consolidate).
ORDER_NOTIFY_EMAIL=gospel.necklace@yahoo.com

# Public site origin — used for canonical URLs, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://www.davidas.com
